{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app22",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e5be3cb4-5782-4854-891f-88031bb82cf2","database_name": "web-app22" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4f19df3928d647a28abcf12b63595b5a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
